# Build stage
FROM python:3.11-slim

LABEL maintainer="sales-agent"
LABEL description="Servidor MCP del agente de analisis de ventas (streamable-http)"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_TRANSPORT=streamable-http

WORKDIR /app

# Instalar dependencias primero (cacheable layer)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar codigo
COPY app/ ./app/

# Solo el dataset estatico -- memory.json no aplica aca, el MCP no usa
# memoria de chat, no tiene sentido empaquetarlo en esta imagen
COPY data/ventas.csv ./data/ventas.csv

# Usuario no-root por seguridad
RUN adduser --disabled-password --gecos "" appuser && chown -R appuser /app
USER appuser

CMD ["python", "-m", "app.mcp_server"]