```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
.venv/
venv/
env/
.env
.env.local
.env.*

# Test coverage and cache
.pytest_cache/
.coverage
coverage/
htmlcov/

# Data files that might be temporary
data/*.json

# Logs
*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS files
.DS_Store
Thumbs.db
```