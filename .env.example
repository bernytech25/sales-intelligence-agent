# ── Variables de Entorno y Secretos para Cloud Run ────────────────────────────
# 
# Este archivo documenta las variables necesarias para desplegar en Cloud Run.
# NO subir este archivo con valores reales al repositorio.
#
# Instrucciones de configuración:
# https://cloud.google.com/secret-manager/docs/creating-and-accessing-secrets
#
# PASOS:
# 1. Crear los secretos en Secret Manager:
#    gcloud secrets create jwt-secret-key --data-file=jwt_secret_key.txt
#    gcloud secrets create google-api-key --data-file=google_api_key.txt
#
# 2. Desplegar en Cloud Run con los secretos:
#    gcloud run deploy sales-agent \
#      --image gcr.io/YOUR_PROJECT_ID/sales-agent:latest \
#      --set-secrets="JWT_SECRET_KEY=jwt-secret-key:latest,GOOGLE_API_KEY=google-api-key:latest" \
#      --region us-central1
#
# Alternativamente, usar variables de entorno directas (menos seguro):
#    gcloud run deploy sales-agent \
#      --image gcr.io/YOUR_PROJECT_ID/sales-agent:latest \
#      --set-env-vars="JWT_SECRET_KEY=tu-clave-segura-aqui,GOOGLE_API_KEY=tu-api-key" \
#      --region us-central1

# Variables requeridas (deben configurarse en Cloud Run):
JWT_SECRET_KEY=              # Clave secreta para firmar JWT (mínimo 32 caracteres recomendados)
GOOGLE_API_KEY=              # API Key de Google Gemini

# Variables opcionales con defaults:
GEMINI_MODEL=gemini-3.1-flash-lite
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=*
JWT_EXPIRE_MINUTES=60
